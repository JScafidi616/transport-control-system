# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Google OAuth (if using Google Sign-In)
GOOGLE_CLIENT_ID_MOBILE=your-google-client-id
GOOGLE_CLIENT_ID_WEB=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudflare D1 Database ID (get from wrangler d1 list)
D1_DATABASE_ID=your-d1-database-id

# API Base URL
API_BASE_URL=https://your-worker.workers.dev

# Frontend URLs (for CORS)
FRONTEND_MOBILE_URL=your-mobile-app-url
FRONTEND_WEB_URL=your-web-app-url

